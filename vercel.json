{
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/__clerk/:path*", "destination": "/api/clerk-proxy" },
    { "source": "/app",            "destination": "/index.html" },
    { "source": "/app.html",       "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
