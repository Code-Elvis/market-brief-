{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/app",      "destination": "/index.html" },
    { "source": "/help",     "destination": "/help.html" },
    { "source": "/",         "destination": "/landing.html" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/auto-brief",
      "schedule": "30 12 * * 1-5"
    },
    {
      "path": "/api/narratives",
      "schedule": "*/15 13-21 * * 1-5"
    }
  ]
}
